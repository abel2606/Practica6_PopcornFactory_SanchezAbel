<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SeatsSelection">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"/>
        <TextView
            android:id="@+id/titleSeats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="yellow"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="20dp"
            android:textSize="@dimen/titleSize"
            />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/yellow"
            android:layout_marginHorizontal="15dp"
            android:layout_marginTop="32dp"
            />

        <RadioGroup
            android:layout_width="match_parent"
            android:id="@+id/row1"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/marginTopRadioGroup"
            android:paddingHorizontal="@dimen/hradiogroup"
            >

            <RadioButton
                android:layout_width="@dimen/radiobutton"
                android:layout_height="@dimen/radiobutton"
                android:text="1"
                android:layout_marginHorizontal="@dimen/hmrb"
                android:textAlignment="center"
                android:textColor="@color/black_backgroun"
                android:background="@drawable/radio_selectable"
                android:textSize="@dimen/radiobutton"
                android:textStyle="bold"
                />
            <RadioButton
                android:layout_width="@dimen/radiobutton"
                android:layout_height="@dimen/radiobutton"
                android:text="2"
                android:layout_marginHorizontal="@dimen/hmrb"
                android:textAlignment="center"
                android:textColor="@color/black_backgroun"
                android:background="@drawable/radio_selectable"
                android:textSize="@dimen/radiobutton"
                android:textStyle="bold"
                />


        </RadioGroup>

</LinearLayout>